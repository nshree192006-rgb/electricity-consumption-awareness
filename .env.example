# IBM Langflow Configuration
# Base URL of your deployed IBM Langflow instance
VITE_LANGFLOW_BASE_URL=http://localhost:7860

# The Flow ID from your Langflow deployment
# Find it in Langflow UI → Your Flow → Settings → Flow ID
VITE_FLOW_ID=your-flow-id-here

# Optional: Langflow API Key (if authentication is enabled)
VITE_LANGFLOW_API_KEY=

# IBM watsonx.ai (used inside Langflow — set in Langflow's component settings)
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
